{
	"compilerOptions": {
		"declaration": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@opentui/solid",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "dist",
		"rootDir": "src",
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}

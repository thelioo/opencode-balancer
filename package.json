{
	"bugs": {
		"url": "https://github.com/thelioo/opencode-balancer/issues"
	},
	"dependencies": {
		"@opencode-ai/plugin": "^1.14.51",
		"@opentui/solid": "^0.2.16",
		"solid-js": "^1.9.12"
	},
	"description": "Account balancer plugin for opencode.",
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^2.31.0",
		"@types/bun": "^1.3.14",
		"@typescript/native-preview": "7.0.0-dev.20260607.1",
		"concurrently": "^10.0.3",
		"husky": "^9.1.7"
	},
	"exports": {
		".": {
			"default": "./dist/index.js"
		},
		"./tui": {
			"default": "./dist/tui/tui.tsx"
		}
	},
	"files": [
		"dist",
		"README.md",
		"INSTALL.txt",
		"LICENSE"
	],
	"homepage": "https://github.com/thelioo/opencode-balancer#readme",
	"keywords": [
		"opencode",
		"opencode-plugin",
		"balancer",
		"accounts"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "@thelioo/opencode-balancer",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thelioo/opencode-balancer.git"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"changeset": "changeset",
		"checktypes": "tsgo --noEmit --project tsconfig.json",
		"format": "biome format --write src test package.json tsconfig.json tsconfig.build.json",
		"lint": "biome check .",
		"lint:fix": "biome check . --fix",
		"lint:unsafe": "biome check . --fix --unsafe",
		"prepare": "husky",
		"prepublishOnly": "bun run build",
		"release": "changeset publish",
		"test": "bun test",
		"version-packages": "changeset version && bun install --lockfile-only"
	},
	"type": "module",
	"version": "0.1.8"
}

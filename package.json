        "opencode-plugin",
        "balancer",
        "accounts"
    ],
    "license": "MIT",
    "dependencies": {
        "@opencode-ai/plugin": "^1.14.51"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "typescript": "^5.9.3"
    }

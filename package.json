{
    "name": "@thelioo/opencode-balancer",
    "version": "0.1.8",
    "description": "Account balancer plugin for opencode.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui/tui.d.ts",
            "default": "./dist/tui/tui.tsx"
        }
    },
    "files": [
        "dist",
        "README.md",
        "INSTALL.txt",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsgo --project tsconfig.json && node scripts/copy-tui-source.mjs",
        "check": "tsgo --noEmit --project tsconfig.json",
        "test": "bun test",
        "changeset": "changeset",
        "version-packages": "changeset version && bun install --lockfile-only",
        "release": "changeset publish",
        "prepublishOnly": "npm run build",
        "prepare": "husky"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "balancer",
        "accounts"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thelioo/opencode-balancer.git"
    },
    "bugs": {
        "url": "https://github.com/thelioo/opencode-balancer/issues"
    },
    "homepage": "https://github.com/thelioo/opencode-balancer#readme",
    "license": "MIT",
    "dependencies": {
        "@opencode-ai/plugin": "^1.14.51",
        "@opentui/solid": "^0.2.16",
        "solid-js": "^1.9.12"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@types/bun": "^1.3.14",
        "@typescript/native-preview": "7.0.0-dev.20260607.1",
        "husky": "^9.1.7"
    }
}

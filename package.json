{
    "name": "@thelioo/opencode-balancer",
    "version": "0.1.2",
    "description": "Account balancer plugin for opencode.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "INSTALL.txt",
